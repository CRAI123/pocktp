{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "教师工作台",
  "version": "2.0.2",
  "identifier": "cn.rayzo.teach",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "教师工作台",
        "url": "https://teach.rayzo.cn/?desktop=1",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "Rayzo",
    "copyright": "Copyright © 2026 Rayzo · 保留所有权利",
    "shortDescription": "教师工作台 —— AI 出题与班级管理一站式桌面客户端",
    "longDescription": "教师工作台 Windows 桌面版，由 Rayzo 提供。AI 出题、组卷打印、班级管理一站式完成。纯净安装：无捆绑软件、无开机自启、免管理员权限、卸载不留驻留进程。",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NkNBREZFM0Y3Q0Y1NjIKUldSaTlYdy8vcTFzV1dqdEFsWjdkZkhEWVdHK0VmSGU4OEs1bTdkTitML2t1eXBmMFpZOE9CaUQK",
      "endpoints": ["https://teach.rayzo.cn/desktop/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
